# ==============================================================================
# ByGoodAI Platform - Environment Variables Specification (.env.example)
# ==============================================================================
# This template documents all configuration variables required for development,
# testing, and production deployment.
# NEVER commit real production secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & DEPLOYMENT RUNTIME
# ------------------------------------------------------------------------------
# NODE_ENV: Runtime environment (development | production | test)
NODE_ENV="production"

# APP_URL / BACKEND_URL: Public production URL where the application/backend is hosted
APP_URL="https://your-domain.example"
BACKEND_URL="https://your-domain.example"

# FRONTEND_URL: Public production URL of the frontend (if hosted separately)
FRONTEND_URL="https://your-domain.example"

# CORS_ORIGIN: Comma-separated list of allowed CORS origins for production APIs
CORS_ORIGIN="https://your-domain.example"

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL / Prisma)
# ------------------------------------------------------------------------------
# DATABASE_URL: PostgreSQL connection string with SSL/pooling for production
# For production: postgresql://<user>:<password>@<host>:5432/<database>?sslmode=require&connection_limit=20
DATABASE_URL="postgresql://user:password@localhost:5432/bygoodai_db?schema=public"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SESSIONS
# ------------------------------------------------------------------------------
# AUTH_SECRET: 32+ character cryptographically random key used for server-side auth token generation
AUTH_SECRET="generate-a-secure-32-character-random-secret"

# ------------------------------------------------------------------------------
# 4. GEMINI AI INTEGRATION (Server-Side Only)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Google Gemini API Key (keep strictly on the server, never expose to client)
GEMINI_API_KEY="AIzaSy..."

# ------------------------------------------------------------------------------
# 5. RAZORPAY BILLING - DOMESTIC INDIA (INR)
# ------------------------------------------------------------------------------
# RAZORPAY_KEY_ID: Razorpay Key ID (rzp_test_... or rzp_live_...)
RAZORPAY_KEY_ID="rzp_live_your_key_id"

# RAZORPAY_KEY_SECRET: Razorpay Key Secret (Server-only secret, never expose to client)
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"

# RAZORPAY_WEBHOOK_SECRET: Secret for HMAC-SHA256 signature verification of webhook events
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# RAZORPAY_PRO_PLAN_ID: Razorpay Monthly Subscription Plan ID for Pro (₹199/month)
RAZORPAY_PRO_PLAN_ID="plan_pro_monthly"

# RAZORPAY_ENTERPRISE_PLAN_ID: Razorpay Monthly Subscription Plan ID for Enterprise (₹999/month)
RAZORPAY_ENTERPRISE_PLAN_ID="plan_enterprise_monthly"

# ------------------------------------------------------------------------------
# 6. RAZORPAY BILLING - INTERNATIONAL / GLOBAL (OPTIONAL)
# ------------------------------------------------------------------------------
# Leave disabled ("false") until international capability and specific currency plans
# are actively created on your Razorpay dashboard.
RAZORPAY_INTERNATIONAL_ENABLED="false"
RAZORPAY_GLOBAL_CURRENCY=""
RAZORPAY_GLOBAL_PRO_PLAN_ID=""
RAZORPAY_GLOBAL_ENTERPRISE_PLAN_ID=""

# ------------------------------------------------------------------------------
# 7. SEEDING & DEVELOPMENT (OPTIONAL)
# ------------------------------------------------------------------------------
# SEED_ADMIN_EMAIL="admin@bygoodai.example"
# SEED_ADMIN_PASSWORD="super-secret-admin-password"


